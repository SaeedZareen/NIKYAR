<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_leave" targetNamespace="http://nikyar.ir/bpmn">
  <bpmn:process id="leave_request" name="درخواست مرخصی" isExecutable="true">
    <bpmn:startEvent id="start" name="شروع">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="submit" name="ثبت درخواست مرخصی" camunda:assignee="initiator">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="leave_type" label="نوع مرخصی" type="enum" defaultValue="estehghaghi">
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
            <camunda:value id="estehghaghi" name="استحقاقی" />
            <camunda:value id="estelaji" name="استعلاجی" />
            <camunda:value id="bedoon_hoghoogh" name="بدون حقوق" />
          </camunda:formField>
          <camunda:formField id="start_date" label="از تاریخ" type="date">
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
          <camunda:formField id="days" label="تعداد روز" type="long" defaultValue="1">
            <camunda:validation>
              <camunda:constraint name="required" />
              <camunda:constraint name="min" config="1" />
              <camunda:constraint name="max" config="30" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="reason" label="توضیحات" type="string">
            <camunda:properties><camunda:property id="multiline" value="true" /></camunda:properties>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="manager_review" name="بررسی مدیر مستقیم" camunda:assignee="initiator_manager">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="decision" label="نظر مدیر" type="enum">
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
            <camunda:value id="approve" name="موافقت" />
            <camunda:value id="reject" name="مخالفت" />
          </camunda:formField>
          <camunda:formField id="manager_note" label="یادداشت مدیر" type="string">
            <camunda:properties><camunda:property id="multiline" value="true" /></camunda:properties>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw" name="موافقت شد؟">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f_yes</bpmn:outgoing>
      <bpmn:outgoing>f_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="hr_register" name="ثبت در امور اداری" camunda:candidateGroups="position:hr-expert">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="hr_registered" label="مرخصی در سامانه‌ی حضور و غیاب ثبت شد" type="boolean">
            <camunda:validation><camunda:constraint name="required" /></camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>f_yes</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_ok" name="مرخصی تأیید شد">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_reject" name="درخواست رد شد">
      <bpmn:incoming>f_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="manager_review" />
    <bpmn:sequenceFlow id="f3" sourceRef="manager_review" targetRef="gw" />
    <bpmn:sequenceFlow id="f_yes" name="موافقت" sourceRef="gw" targetRef="hr_register">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no" name="مخالفت" sourceRef="gw" targetRef="end_reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="hr_register" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_leave">
    <bpmndi:BPMNPlane id="Plane_leave" bpmnElement="leave_request">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="155" y="225" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="submit_di" bpmnElement="submit">
        <dc:Bounds x="240" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manager_review_di" bpmnElement="manager_review">
        <dc:Bounds x="410" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_di" bpmnElement="gw" isMarkerVisible="true">
        <dc:Bounds x="585" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="575" y="145" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hr_register_di" bpmnElement="hr_register">
        <dc:Bounds x="700" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok">
        <dc:Bounds x="882" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="860" y="225" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reject_di" bpmnElement="end_reject">
        <dc:Bounds x="592" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="570" y="365" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="360" y="200" /><di:waypoint x="410" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="530" y="200" /><di:waypoint x="585" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_yes_di" bpmnElement="f_yes">
        <di:waypoint x="635" y="200" /><di:waypoint x="700" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="645" y="182" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_no_di" bpmnElement="f_no">
        <di:waypoint x="610" y="225" /><di:waypoint x="610" y="322" />
        <bpmndi:BPMNLabel><dc:Bounds x="620" y="265" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="820" y="200" /><di:waypoint x="882" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
