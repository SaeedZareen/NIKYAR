      "type": "matrix",
      "label": "شاخص‌های عملکرد",
      "required": true,
      "props": {
       "rows": [
        {
         "value": "row_1",
         "label": "کیفیت کار"
        },
        {
         "value": "row_2",
         "label": "دقت و نظم"
        },
        {
         "value": "row_3",
         "label": "همکاری و کار گروهی"
        },
        {
         "value": "row_4",
         "label": "مسئولیت‌پذیری"
        },
        {
         "value": "row_5",
         "label": "ابتکار و یادگیری"
        }
       ],
       "columns": [
        {
         "value": "1",
         "label": "ضعیف"
        },
        {
         "value": "2",
         "label": "متوسط"
        },
        {
         "value": "3",
         "label": "خوب"
        },
        {
         "value": "4",
         "label": "خیلی خوب"
        },
        {
         "value": "5",
         "label": "عالی"
        }
       ]
      }
     },
     {
