<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_leave" targetNamespace="http://nikyar.ir/bpmn">
  <bpmn:process id="leave_request" name="درخواست مرخصی" isExecutable="true">
    <bpmn:startEvent id="start" name="شروع"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="submit" name="ثبت درخواست" camunda:assignee="initiator">
      <bpmn:documentation>نوع مرخصی، تاریخ شروع و تعداد روز را وارد کنید.</bpmn:documentation>
      <bpmn:extensionElements><camunda:properties>
        <camunda:property name="fieldAccess" value="{&quot;leave_type&quot;:&quot;edit&quot;,&quot;start_date&quot;:&quot;edit&quot;,&quot;days&quot;:&quot;edit&quot;,&quot;reason&quot;:&quot;edit&quot;,&quot;manager_note&quot;:&quot;hidden&quot;,&quot;hr_registered&quot;:&quot;hidden&quot;}" />
        <camunda:property name="outcomes" value="[{&quot;code&quot;:&quot;submit&quot;,&quot;title&quot;:&quot;ارسال برای تأیید&quot;,&quot;style&quot;:&quot;primary&quot;}]" />
      </camunda:properties></bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="manager_review" name="بررسی مدیر مستقیم" camunda:assignee="initiator_manager">
      <bpmn:extensionElements><camunda:properties>
        <camunda:property name="fieldAccess" value="{&quot;manager_note&quot;:&quot;edit&quot;,&quot;hr_registered&quot;:&quot;hidden&quot;}" />
        <camunda:property name="outcomes" value="[{&quot;code&quot;:&quot;approve&quot;,&quot;title&quot;:&quot;موافقت&quot;,&quot;style&quot;:&quot;primary&quot;},{&quot;code&quot;:&quot;reject&quot;,&quot;title&quot;:&quot;مخالفت&quot;,&quot;style&quot;:&quot;danger&quot;}]" />
        <camunda:property name="dueHours" value="24" />
      </camunda:properties></bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw" name="نتیجه‌ی بررسی"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f_yes</bpmn:outgoing><bpmn:outgoing>f_no</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="hr_register" name="ثبت در امور اداری" camunda:assignee="position:hr-expert">
      <bpmn:extensionElements><camunda:properties>
        <camunda:property name="fieldAccess" value="{&quot;hr_registered&quot;:&quot;edit&quot;}" />
        <camunda:property name="outcomes" value="[{&quot;code&quot;:&quot;done&quot;,&quot;title&quot;:&quot;ثبت شد&quot;,&quot;style&quot;:&quot;primary&quot;}]" />
      </camunda:properties></bpmn:extensionElements>
      <bpmn:incoming>f_yes</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_ok" name="مرخصی تأیید شد"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="end_reject" name="درخواست رد شد"><bpmn:incoming>f_no</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="manager_review" />
    <bpmn:sequenceFlow id="f3" sourceRef="manager_review" targetRef="gw" />
    <bpmn:sequenceFlow id="f_yes" name="موافقت" sourceRef="gw" targetRef="hr_register">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">manager_review_outcome == "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no" name="مخالفت" sourceRef="gw" targetRef="end_reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">manager_review_outcome == "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="hr_register" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_leave">
    <bpmndi:BPMNPlane id="Plane_leave" bpmnElement="leave_request">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="152" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="155" y="225" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="submit_di" bpmnElement="submit"><dc:Bounds x="240" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manager_review_di" bpmnElement="manager_review"><dc:Bounds x="410" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_di" bpmnElement="gw" isMarkerVisible="true"><dc:Bounds x="585" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="570" y="145" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hr_register_di" bpmnElement="hr_register"><dc:Bounds x="700" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="882" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="860" y="225" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reject_di" bpmnElement="end_reject"><dc:Bounds x="592" y="322" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="570" y="365" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="360" y="200" /><di:waypoint x="410" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="530" y="200" /><di:waypoint x="585" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_yes_di" bpmnElement="f_yes"><di:waypoint x="635" y="200" /><di:waypoint x="700" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="645" y="182" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_no_di" bpmnElement="f_no"><di:waypoint x="610" y="225" /><di:waypoint x="610" y="322" /><bpmndi:BPMNLabel><dc:Bounds x="620" y="265" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="820" y="200" /><di:waypoint x="882" y="200" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
