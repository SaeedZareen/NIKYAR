    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "ajv": "^8.20.0",
