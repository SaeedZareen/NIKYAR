{
  "name": "nikyar-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:types": "cd ../backend && ../.venv/bin/python manage.py spectacular --file ../frontend/node_modules/.tmp/openapi.yaml && cd ../frontend && npx --yes openapi-typescript@7 node_modules/.tmp/openapi.yaml -o src/lib/api/schema.d.ts"
  },
